---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import Nav from '../../components/Nav.astro'
import Footer from '../../components/Footer.astro'
import gmvVideo from '../../assets/work-images/gmv/cover.mp4'

// Published case studies only — drafts (lorem ipsum scaffolds like ui-core)
// stay off this page the same way they stay out of the sitemap + llms.txt.
// Featured first, then by order.
const entries = (await getCollection('work', ({ data }) => !data.draft)).sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1
  return a.data.order - b.data.order
})

// Same card shape as the homepage "Work" section (PortfolioHighlight.astro) —
// this page is the full list, so it reuses that grid rather than inventing a
// second visual language. GMV's video cover is carried over the same way,
// since it isn't part of the content-collection schema (image() only).
const cards = entries.map((e) => ({
  title: e.data.client,
  href: `/work/${e.id}`,
  category: e.data.tagline,
  tags: e.data.services,
  description: e.data.summary,
  img: e.data.heroImage ?? null,
  video: e.id === 'global-minang-ventura' ? gmvVideo : null,
}))

const needsFiller = cards.length % 2 === 1
const pad = (n: number) => String(n).padStart(2, '0')
---

<BaseLayout
  title="Work — Shipped, not shelved | Elux Space"
  description="Case studies from Elux Space: AI-native product design and build work across venture, SaaS, AI, and ecommerce teams."
>
  <div class="bg-cream text-ink min-h-screen">
    <Nav />

    <main id="main">
      <section class="bg-cream border-b-2 border-ink">
        <div class="mx-auto max-w-page px-6 lg:px-10 py-16 md:py-24">
          <div class="eyebrow text-ink-3 mb-3">THE WORK THAT PROVES IT</div>
          <h1 class="display-xl text-ink mb-5">SHIPPED.<br />NOT SHELVED.</h1>
          <p class="body-lg text-ink-2 max-w-xl">
            Good output is the result of a better process. Here is what that looks like in practice.
          </p>
        </div>
      </section>

      <section class="bg-cream">
        <div class="mx-auto max-w-page px-6 lg:px-10 py-16 md:py-24">
          <div class="grid md:grid-cols-2 gap-x-6 gap-y-12">
            {
              cards.map((c, i) => (
                <a href={c.href} data-reveal style={`transition-delay: ${(i % 2) * 0.06}s`} class="group block">
                  <div class="relative w-full aspect-[16/10] rounded-media overflow-hidden">
                    {c.video ? (
                      <video
                        src={c.video}
                        class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                        autoplay
                        muted
                        loop
                        playsinline
                        preload="metadata"
                        aria-hidden="true"
                      />
                    ) : c.img ? (
                      <div
                        class="absolute inset-0 bg-cover bg-center transition-transform duration-500 group-hover:scale-[1.03]"
                        style={`background-image: url(${c.img.src});`}
                        aria-hidden="true"
                      />
                    ) : (
                      <div class="img-placeholder absolute inset-0 rounded-media">
                        IMAGE: {c.title} — replace with real work shot (16:10)
                      </div>
                    )}
                    <div class="absolute inset-0 rounded-media ring-1 ring-inset ring-ink/10" />
                  </div>

                  <div class="pt-5">
                    <div class="flex items-center gap-3 mb-3">
                      <span class="font-body font-semibold text-[11px] tracking-[0.14em] text-ink-3 tabular-nums">
                        {pad(i + 1)}
                      </span>
                      <span class="font-body font-semibold text-[10px] uppercase tracking-[0.12em] text-primary">
                        {c.category}
                      </span>
                    </div>

                    <h3 class="font-display font-bold text-[19px] md:text-[22px] tracking-[-0.01em] text-ink mb-3 group-hover:text-primary transition-colors">
                      {c.title}
                    </h3>

                    {c.tags.length > 0 && (
                      <ul class="flex flex-wrap gap-2 mb-3">
                        {c.tags.map((t) => (
                          <li class="font-body font-semibold text-[10px] uppercase tracking-[0.1em] text-ink-2 border border-ink/20 px-2.5 py-1 rounded-chip">
                            {t}
                          </li>
                        ))}
                      </ul>
                    )}

                    <p class="font-body text-[14px] text-ink-2 leading-relaxed max-w-prose">{c.description}</p>
                  </div>
                </a>
              ))
            }

            {
              needsFiller && (
                <div data-reveal class="hidden md:block" data-placeholder-tile>
                  <div class="img-placeholder w-full aspect-[16/10] rounded-media">
                    PLACEHOLDER TILE — add another case study, or drop this block
                  </div>
                  <div class="pt-5">
                    <div class="flex items-center gap-3 mb-3">
                      <span class="font-body font-semibold text-[11px] tracking-[0.14em] text-ink-3 tabular-nums">
                        {pad(cards.length + 1)}
                      </span>
                      <span class="font-body font-semibold text-[10px] uppercase tracking-[0.12em] text-ink-3">
                        NEXT CASE STUDY
                      </span>
                    </div>
                    <h3 class="font-display font-bold text-[19px] md:text-[22px] tracking-[-0.01em] text-ink-3 mb-3">
                      Your project here
                    </h3>
                    <p class="font-body text-[14px] text-ink-3 leading-relaxed max-w-prose">
                      This tile only exists to square off the grid. Replace it with real work or remove
                      it once there is an even number of case studies.
                    </p>
                  </div>
                </div>
              )
            }
          </div>
        </div>
      </section>

      <section class="bg-cream border-t-2 border-ink">
        <div class="mx-auto max-w-page px-6 lg:px-10 py-16 md:py-20 flex flex-col md:flex-row md:items-end md:justify-between gap-8">
          <h2 class="display-lg text-ink">SEE SOMETHING<br />THAT FITS?</h2>
          <a href="/#contact" class="btn-primary">
            START A PROJECT
            <span aria-hidden="true" class="inline-block w-4 h-4 leading-none">↗</span>
          </a>
        </div>
      </section>
    </main>

    <Footer />
  </div>
</BaseLayout>
