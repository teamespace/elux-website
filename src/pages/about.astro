---
import { getEntry } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import TheShift from '../components/sections/TheShift.astro'

const { data: a } = await getEntry('standalone', 'about')
const { data: home } = await getEntry('pages', 'home')
const own = home.ownProducts

const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://elux.space'
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${site}/#organization`,
  name: 'Elux Space',
  url: `${site}/`,
  description:
    'The UI/UX studio that went AI-native. Product design and build in one connected sprint.',
  // foundingDate intentionally omitted until known — never ship a placeholder as
  // a structured-data value. Add it back in about.yaml/here once confirmed.
}
const closingLines = a.closing.headline.split('\n')
---

<BaseLayout
  title="About — The UI/UX studio that went AI-native | Elux Space"
  description="Elux Space shipped 95+ products as a UI/UX studio, then rebuilt itself AI-native. Design and build now run in one sprint. This is the story of the shift."
  noindex={true}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

  <div class="bg-cream text-ink min-h-screen">
    <Nav />

    <main id="main">
      <!-- 1. Hero — the full-strength confession, static on both lines -->
      <section class="bg-cream border-b-2 border-ink">
        <div class="mx-auto max-w-page px-6 lg:px-10 py-20 md:py-28">
          <div data-reveal class="eyebrow text-ink-3 mb-6">{a.hero.eyebrow}</div>
          <h1 class="display-xl text-ink">
            <span class="block text-ink-3 line-through decoration-primary/50 decoration-[3px]" data-reveal>{a.hero.headlineLine1}</span>
            <span class="block" data-reveal style="transition-delay: 0.08s">{a.hero.headlineLine2}</span>
          </h1>
        </div>
      </section>

      <!-- 2. Story — THEN / THE SHIFT / NOW -->
      <section class="bg-cream">
        <div class="mx-auto max-w-page px-6 lg:px-10 py-16 md:py-24">
          <div data-reveal class="eyebrow text-ink-3 mb-12">{a.story.eyebrow}</div>
          <div class="flex flex-col gap-14">
            {
              a.story.chapters.map((ch, i) => (
                <div data-reveal style={`transition-delay: ${i * 0.08}s`} class="grid lg:grid-cols-[0.4fr_0.6fr] gap-6 lg:gap-12">
                  <div>
                    <div class="font-display font-bold text-[11px] uppercase tracking-[0.16em] text-primary mb-3">{ch.label}</div>
                    <h2 class="display-md text-ink">{ch.title}</h2>
                  </div>
                  <p class="placeholder-copy body-lg text-ink-2 self-center">{ch.body}</p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- 2b. The full manifesto — relocated from the homepage (the home now
           carries one sharp shift section; the long-form "why" lives here). -->
      <TheShift />

      <!-- 3. Timeline -->
      <section class="bg-clay border-y-2 border-ink">
        <div class="mx-auto max-w-page px-6 lg:px-10 py-16 md:py-24">
          <div data-reveal class="mb-12">
            <div class="eyebrow text-ink-3 mb-3">{a.timeline.eyebrow}</div>
            <h2 class="display-lg text-ink">{a.timeline.headline}</h2>
          </div>
          <ol class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
            {
              a.timeline.milestones.map((m, i) => (
                <li data-reveal style={`transition-delay: ${i * 0.08}s`} class="border-t-2 border-ink pt-5">
                  <div class="font-display font-bold text-lg text-primary mb-2">{m.year}</div>
                  <div class="font-display font-bold text-base uppercase tracking-tight text-ink mb-2">{m.title}</div>
                  <p class="body-md text-ink-2">{m.text}</p>
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      <!-- 4. Team -->
      <section class="bg-cream">
        <div class="mx-auto max-w-page px-6 lg:px-10 py-16 md:py-24">
          <div data-reveal class="mb-12">
            <div class="eyebrow text-ink-3 mb-3">{a.team.eyebrow}</div>
            <h2 class="display-lg text-ink">{a.team.headline}</h2>
          </div>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
            {
              a.team.members.map((mem, i) => (
                <div data-reveal style={`transition-delay: ${i * 0.06}s`}>
                  <div class="img-placeholder aspect-square rounded-chip mb-4">PHOTO: team member {i + 1}</div>
                  <div class="font-display font-bold text-base uppercase text-ink">{mem.name}</div>
                  <div class="font-body text-sm text-ink-3 mb-2">{mem.role}</div>
                  <p class="placeholder-copy body-md text-ink-2">{mem.bio}</p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- 5. Principles -->
      <section class="bg-ink-bg text-on-ink">
        <div class="mx-auto max-w-page px-6 lg:px-10 py-16 md:py-24">
          <div data-reveal class="mb-12">
            <div class="eyebrow text-butter mb-3">{a.principles.eyebrow}</div>
            <h2 class="display-lg text-on-ink">{a.principles.headline}</h2>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-10">
            {
              a.principles.items.map((p, i) => (
                <div data-reveal style={`transition-delay: ${i * 0.06}s`} class="border-t border-line-ink pt-5">
                  <h3 class="font-display font-bold text-lg uppercase tracking-tight text-on-ink mb-3">{p.title}</h3>
                  <p class="placeholder-copy body-md text-on-ink-2">{p.text}</p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- 6. Own products strip (reused from the homepage data; the homepage
           links here via the OwnProductsTeaser → /about#products) -->
      <section id="products" class="bg-cream border-t-2 border-ink">
        <div class="mx-auto max-w-page px-6 lg:px-10 py-16 md:py-24">
          <div data-reveal class="mb-10">
            <div class="eyebrow text-ink-3 mb-3">{own.eyebrow}</div>
            <h2 class="display-lg text-ink">{own.headline}</h2>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {
              own.products.map((p) => (
                <div class="border-2 border-ink rounded-chip p-6 bg-cream-3">
                  <div class="flex items-center justify-between mb-3">
                    <span class="font-display font-bold text-[10px] uppercase tracking-[0.1em] text-primary">{p.tag}</span>
                    <span class="font-body text-[11px] text-ink-3">{p.status}</span>
                  </div>
                  <div class="font-display font-bold text-xl uppercase text-ink mb-2">{p.title}</div>
                  <p class="body-md text-ink-2 mb-4">{p.description}</p>
                  <a href={`https://${p.link}`} target="_blank" rel="noreferrer" class="font-display font-bold text-[11px] uppercase tracking-[0.1em] text-primary hover:underline">
                    {p.link} ↗
                  </a>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- 7. Closing CTA -->
      <section class="bg-cream border-t-2 border-ink">
        <div class="mx-auto max-w-page px-6 lg:px-10 py-16 md:py-20 flex flex-col md:flex-row md:items-end md:justify-between gap-8">
          <h2 class="display-lg text-ink whitespace-pre-line">{closingLines.join('\n')}</h2>
          <a href="/#contact" class="btn-primary">
            {a.closing.cta}
            <span aria-hidden="true" class="inline-block w-4 h-4 leading-none">↗</span>
          </a>
        </div>
      </section>
    </main>

    <Footer />
  </div>
</BaseLayout>
