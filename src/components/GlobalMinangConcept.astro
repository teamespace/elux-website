  /* square polaroid — Sederhana's Singapore storefront */
  .gmv-photo--square { width: 190px; }
  .gmv-photo--square .gmv-photo__frame { aspect-ratio: 1 / 1; }
  /* landscape polaroid — the full map frame, uncropped */
  .gmv-photo--landscape .gmv-photo__frame { aspect-ratio: 16 / 9; }

  /* "From Indonesia, outward" — a sticky note of points instead of a map graphic */
  .gmv-sticky--paper { background: #FCF8F0; border-top: 4px solid #A9541F; justify-content: flex-start; }
  .gmv-sticky--paper small { display: block; font: 800 8px/1 Inter, system-ui, sans-serif; text-transform: uppercase; letter-spacing: .14em; color: #736049; margin-bottom: 8px; }
  .gmv-sticky--paper strong { display: block; font: 700 20px/1.1 'Iowan Old Style', Georgia, serif; color: #3E2002; margin-bottom: 14px; }
  .gmv-sticky__points { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 7px; }
  .gmv-sticky__points li { position: relative; padding-left: 14px; font-size: 11.5px; line-height: 1.4; color: #6D543C; }
  .gmv-sticky__points li::before { content: ''; position: absolute; left: 0; top: 6px; width: 6px; height: 6px; border-radius: 50%; background: #A9541F; }

  /* newspaper clipping — back on the board, real facts this time */
  .gmv-clipping {
    width: 230px; padding: 16px 16px 18px; display: flex; flex-direction: column;
    background: #F1E9DA;
    clip-path: polygon(0 0, 100% 0, 100% 96%, 95% 100%, 89% 96%, 83% 100%, 77% 96%, 71% 100%, 65% 96%, 59% 100%, 53% 96%, 47% 100%, 41% 96%, 35% 100%, 29% 96%, 23% 100%, 17% 96%, 11% 100%, 5% 96%, 0 100%);
  }
  .gmv-clipping__masthead {
    text-align: center; padding-bottom: 6px; margin-bottom: 8px;
    border-bottom: 2px solid #3E2002; border-top: 1px solid #3E2002; padding-top: 4px;
  }
  .gmv-clipping__masthead span {
    font: 700 11px/1 'Iowan Old Style', Georgia, serif; letter-spacing: .14em; text-transform: uppercase; color: #3E2002;
  }
  .gmv-clipping__headline {
    margin: 0 0 10px; font: 700 17px/1.15 'Iowan Old Style', Georgia, serif; color: #3E2002; text-wrap: balance;
  }
  .gmv-clipping__photo { width: 100%; aspect-ratio: 16 / 9; overflow: hidden; filter: grayscale(.4) sepia(.15) contrast(1.05); margin-bottom: 10px; }
  .gmv-clipping__photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .gmv-clipping__body {
    margin: 0; color: #6D543C; font: 400 11px/1.5 'Iowan Old Style', Georgia, serif;
    column-count: 2; column-gap: 12px;
  }

  /* ── flow (POC) ── */
  .gmv-flow { margin-top: 30px; }
  .gmv-poc-proof {
    margin: 18px 0 0; width: max-content; max-width: 100%;
    border: 1px solid #A9541F; color: #A9541F; padding: 8px 10px;
    font: 900 8px/1 Inter, system-ui, sans-serif; text-transform: uppercase; letter-spacing: .12em;
  }
  /* glyph slot — sprites run 32px-68px tall at 4x; a fixed slot with the art
     bottom-aligned keeps every title on the same line, same as #process. */
  .gmv-flow__glyph { height: 68px; }
  @media (max-width: 767px) {
    .gmv-flow__glyph { height: 54px; }
    .gmv-flow__glyph .pixel-sprite { --px: 3; }
  }
  @media (min-width: 768px) {
    .gmv-flow__glyph .pixel-sprite { --px: 4; }
  }

  .gmv-browser { margin-top: 40px; background: #fff; }
  .gmv-browser__frame { aspect-ratio: 16 / 9; overflow: hidden; }
  .gmv-browser__el { width: 100%; height: 100%; object-fit: cover; display: block; }
  .gmv-browser__frame img { width: 100%; height: 100%; object-fit: cover; display: block; }

  /* ── loop workflow — same timeline pattern as the homepage's
     TransformationStrip (Then → Shift → Now): dots on a connecting line,
     bottom-aligned glyph slot above. The eyebrow itself carries the
     highlighted chip this time, same treatment "THE SHIFT" gets there. ── */
  .gmv-loop { margin-top: 8px; position: relative; }
  .gmv-loop__eyebrow { text-align: center; margin-bottom: 40px; }
  .gmv-loop__eyebrow-chip {
    display: inline-block; color: #3E2002; background: #DFE3BE;
    border: 1px solid #3E2002; padding: 6px 10px; border-radius: 4px;
    font: 600 12px/1 Inter, system-ui, sans-serif; letter-spacing: .16em; text-transform: uppercase;
  }
  .gmv-loop__timeline { display: grid; grid-template-columns: repeat(5, 1fr); gap: 20px; margin-bottom: 34px; }
  .gmv-loop__beat { position: relative; display: flex; flex-direction: column; align-items: center; text-align: center; }
  .gmv-loop__glyph-slot { height: 68px; display: flex; align-items: flex-end; justify-content: center; margin-bottom: 16px; image-rendering: pixelated; }
  @media (max-width: 767px) {
    .gmv-loop__glyph-slot { height: 54px; }
    .gmv-loop__glyph-slot .pixel-sprite { --px: 3; }
  }
  .gmv-loop__dot-row { position: relative; display: flex; align-items: center; justify-content: center; width: 100%; height: 14px; margin-bottom: 14px; }
  .gmv-loop__dot { width: 14px; height: 14px; border-radius: 50%; background: #6D543C; flex-shrink: 0; position: relative; z-index: 1; }
  .gmv-loop__line-h { position: absolute; top: 50%; left: 50%; right: calc(-100% - 20px); height: 1px; background: rgba(62,32,2,.25); }
  .gmv-loop__line-v { display: none; }
  .gmv-loop__label { font: 600 11px/1 Inter, system-ui, sans-serif; letter-spacing: .1em; text-transform: uppercase; color: #6D543C; margin-bottom: 10px; }
  .gmv-loop__text { margin: 0; max-width: 20ch; font: 400 13px/1.5 Inter, system-ui, sans-serif; color: #6D543C; }

  .gmv-video-frame { position: relative; z-index: 1; aspect-ratio: 16 / 9; overflow: hidden; background: #111; }
  .gmv-video-frame__el { width: 100%; height: 100%; object-fit: cover; display: block; }

  /* ── CTA, centered ── */
  .gmv-cta { max-width: 960px; margin-inline: auto; text-align: center; }
  .gmv-cta__heading { margin: 0 auto; }
  .gmv-cta__copy { max-width: 680px; margin: 20px auto 0; color: #6D543C; font: 400 17px/1.65 Inter, system-ui, sans-serif; }

  @media (max-width: 960px) {
    /* below this, the fixed-viewport-height board can no longer guarantee
       every pin fits without an internal scrollbar — switch to a natural,
       content-sized board instead so the page scrolls, not the board. */
    .gmv-board { height: auto; min-height: auto; max-height: none; overflow-y: visible; }
    .gmv-mood--a, .gmv-mood--c { width: 300px; }
    .gmv-sticky, .gmv-photo--square { width: 170px; }
    .gmv-clipping { width: 200px; }
    .gmv-loop__timeline { grid-template-columns: 1fr 1fr; row-gap: 34px; }
    .gmv-loop__line-h { display: none; }
