  }
  @media (max-width: 560px) {
    .gmv-loop__timeline { grid-template-columns: 1fr; }
  }
</style>

<script>
  // Hover is pure CSS; this only covers taps, where :hover never fires — same
  // pattern as the homepage #process section.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document
      .querySelectorAll<HTMLElement>('#gmv-flow-steps .pixel-sprite--poke, #gmv-loop-timeline .pixel-sprite--poke')
      .forEach((el) => {
        el.addEventListener('click', () => {
          if (el.classList.contains('is-reacting')) return
          el.classList.add('is-reacting')
          setTimeout(() => el.classList.remove('is-reacting'), 600)
        })
      })
  }

  // Pinboard drag — each pin carries a --dx/--dy translate offset layered on
  // top of its resting rotation (see .gmv-mood in the styles above), so a
  // drag never touches the grid layout, just the painted position.
  function initBoardDrag() {
    const board = document.querySelector<HTMLElement>('#gmv-board')
    if (!board) return

    const clamp = (v: number, min: number, max: number) => Math.min(max, Math.max(min, v))
    const readOffset = (el: HTMLElement, name: string) =>
      parseFloat(getComputedStyle(el).getPropertyValue(name)) || 0

    board.querySelectorAll<HTMLElement>('[data-drag]').forEach((el) => {
      let startX = 0
      let startY = 0
      let baseDx = 0
      let baseDy = 0
      let dragging = false
      // pointer-delta bounds computed at drag start so the card's own
      // (already rotated/scaled) box never crosses the board's edge
      let deltaMinX = 0
      let deltaMaxX = 0
      let deltaMinY = 0
      let deltaMaxY = 0

      el.addEventListener('pointerdown', (e) => {
        dragging = true
        el.classList.add('is-dragging')
        // setPointerCapture can throw (e.g. no active pointer with this id)
        // in some browsers/conditions — never let that skip the bounds setup
        // below, or the drag falls back to stale/zeroed values.
        try {
          el.setPointerCapture(e.pointerId)
        } catch {}
        startX = e.clientX
        startY = e.clientY
        baseDx = readOffset(el, '--dx')
        baseDy = readOffset(el, '--dy')

        const boardRect = board.getBoundingClientRect()
        const elRect = el.getBoundingClientRect()
        deltaMinX = boardRect.left - elRect.left
        deltaMaxX = boardRect.right - elRect.right
        deltaMinY = boardRect.top - elRect.top
        deltaMaxY = boardRect.bottom - elRect.bottom
      })

      el.addEventListener('pointermove', (e) => {
        if (!dragging) return
        const deltaX = clamp(e.clientX - startX, deltaMinX, deltaMaxX)
        const deltaY = clamp(e.clientY - startY, deltaMinY, deltaMaxY)
        el.style.setProperty('--dx', `${baseDx + deltaX}px`)
        el.style.setProperty('--dy', `${baseDy + deltaY}px`)
      })

      const stopDragging = () => {
        dragging = false
        el.classList.remove('is-dragging')
      }
      el.addEventListener('pointerup', stopDragging)
      el.addEventListener('pointercancel', stopDragging)
    })
  }

  initBoardDrag()
</script>
