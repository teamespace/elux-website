  .gmv-sticky--clay small { position: relative; display: block; font: 800 8px/1 Inter, system-ui, sans-serif; text-transform: uppercase; letter-spacing: .14em; margin-bottom: 8px; color: #A9541F; }
  .gmv-sticky--clay strong { position: relative; display: block; font: 700 22px/1.1 'Iowan Old Style', Georgia, serif; color: #3E2002; }
  .gmv-sticky__fold {
    position: absolute; right: 0; bottom: 0; width: 22px; height: 22px; z-index: 4;
