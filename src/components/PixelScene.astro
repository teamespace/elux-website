---
/*
  8-bit space scene along the bottom edge of the closing CTA. An astronaut walks
  the ground line past a flag, two robots and a landed rocket. Click any of them
  and it plays a one-shot reaction.

  Sprite sheets come from scripts/gen-sprites.py. Every sheet follows the same
  contract — 8 frames in one row, 0-3 idle and 4-7 reaction — which is why a
  single pair of keyframes drives the whole cast regardless of frame size.

  Everything shares one --px, so the whole scene is on a single pixel grid. Give
  a prop its own scale and it stops reading as part of the same world.

  Ambient motion is pure CSS: no requestAnimationFrame, because this section
  already runs a canvas loop for the dither field.

  Decorative, so the whole thing is aria-hidden and out of the tab order rather
  than exposing five controls that do nothing.
*/

const props = [
  { name: 'flag', w: 16, h: 26, left: '8%', idle: '1.1s', show: '' },
  { name: 'smallbot', w: 14, h: 20, left: '26%', idle: '0.7s', show: 'hidden md:block' },
  { name: 'bigbot', w: 20, h: 28, left: '54%', idle: '2.6s', show: 'hidden lg:block' },
  { name: 'rocket', w: 22, h: 38, left: '79%', idle: '3.4s', show: '' },
]
---

<div class="px-scene" data-px-scene aria-hidden="true">
  {
    props.map((p) => (
      <div
        class={`px-prop pixel-sprite pixel-sprite--poke ${p.show}`}
        style={`left:${p.left}; --w:${p.w}; --h:${p.h}; --idle:${p.idle}; background-image:url('/sprites/${p.name}.png')`}
      />
    ))
  }

  <div class="px-walker">
    <div
      class="pixel-sprite pixel-sprite--poke px-astronaut"
      style="--w:18; --h:25; --idle:0.55s; background-image:url('/sprites/astronaut.png')"
    />
  </div>

  <!-- Drifts the other way to the astronaut, and slower: two things crossing
       in the same direction at the same speed reads as one moving background. -->
  <div class="px-flyer">
    <div
      class="pixel-sprite pixel-sprite--poke"
      style="--w:22; --h:14; --idle:0.45s; background-image:url('/sprites/ufo.png')"
    />
  </div>
</div>

<style>
  /* Spans the whole section, not just the ground line: the UFO is positioned
     from the top, and a zero-height wrapper gives a percentage nothing to
     resolve against. pointer-events stay off so the CTA underneath is still
     clickable; the sprites opt back in individually. */
  .px-scene {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    --px: 4;
  }

  /* geometry, keyframes and the reaction all live in global.css (.pixel-sprite);
     only the scene-specific bits stay here */
  .px-prop,
  .pixel-sprite {
    pointer-events: auto;
    cursor: pointer;
  }

  /* props stand on the ground line */
  .px-prop {
    position: absolute;
    bottom: 0;
  }

  .px-walker {
    position: absolute;
    bottom: 0;
    left: 0;
    animation: px-cross 38s linear infinite;
  }

  .px-flyer {
    position: absolute;
    top: 16%;
    right: 0;
    animation: px-drift 52s linear infinite;
  }
  @media (max-width: 767px) {
    .px-flyer {
      top: 12%;
    }
  }

  @keyframes px-drift {
    from {
      transform: translateX(120px);
    }
    to {
      transform: translateX(calc(-100vw - 120px));
    }
  }

  @media (max-width: 767px) {
    .px-scene {
      --px: 3;
    }
  }

  @keyframes px-cross {
    from {
      transform: translateX(-80px);
    }
    to {
      transform: translateX(calc(100vw + 80px));
    }
  }

  /* Click: play the reaction once. The astronaut also stops walking, which is
     why the crossing lives on a separate element — it can be paused without
     re-declaring the animation that is currently running. */
  .px-prop.is-reacting,
  .pixel-sprite.is-reacting {
    animation: px-react 0.6s steps(4) 1;
  }
  .px-scene.is-astro-reacting .px-walker {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .px-prop,
    .pixel-sprite,
    .px-walker,
    .px-flyer {
      animation: none;
      background-position-x: 0;
      cursor: default;
    }
    .px-walker {
      transform: translateX(12vw);
    }
    .px-flyer {
      transform: translateX(-70vw);
    }
  }
</style>

<script>
  const scene = document.querySelector<HTMLElement>('[data-px-scene]')

  if (scene && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    scene.addEventListener('click', (e) => {
      const el = (e.target as HTMLElement).closest<HTMLElement>('.px-prop, .pixel-sprite')
      if (!el || el.classList.contains('is-reacting')) return

      const isAstronaut = el.classList.contains('px-astronaut')
      el.classList.add('is-reacting')
      if (isAstronaut) scene.classList.add('is-astro-reacting')

      setTimeout(() => {
        el.classList.remove('is-reacting')
        if (isAstronaut) scene.classList.remove('is-astro-reacting')
      }, 600)
    })
  }
</script>
