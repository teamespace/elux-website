---
import { getEntry } from 'astro:content'
import ClosingCTA from './ClosingCTA.astro'

const { data } = await getEntry('pages', 'home')
const still = data.stillReading
---

<ClosingCTA
  eyebrow={still.eyebrow}
  headline={still.headline}
  primaryLabel={still.primaryCta}
  primaryHref="mailto:project@elux.space"
  secondaryLabel={still.secondaryCta}
  secondaryHref="#work"
/>
