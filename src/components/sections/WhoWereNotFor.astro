---
import { getEntry } from 'astro:content'
import AbductionScene from '../AbductionScene.astro'

const { data } = await getEntry('pages', 'home')
const fit = data.fitCheck
---

<section id="contact" class="relative bg-olive text-on-ink overflow-hidden">
  <AbductionScene mode="flag" dark />
  <div class="mx-auto max-w-page px-6 lg:px-10 py-24 md:py-32">
    <div data-reveal class="mb-16">
      <div class="eyebrow text-on-ink-3 mb-4">{fit.eyebrow}</div>
      <h2 class="display-lg max-w-5xl whitespace-pre-line">{fit.headline}</h2>
      <p class="body-lg text-on-ink-2 mt-7 max-w-2xl">{fit.supportingCopy}</p>
    </div>

    <ul class="flex flex-col">
      {
        fit.builtFor.map((a, i) => (
          <li data-reveal style={`transition-delay: ${i * 0.08}s`} class="py-6 border-b border-line-ink">
            <div class="grid grid-cols-[2rem_1fr] md:grid-cols-[2.5rem_minmax(0,2fr)_minmax(0,3fr)] gap-x-6 md:gap-x-10 items-start">
              <span class="font-display font-bold text-xs text-primary pt-1 tabular-nums">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div class="relative inline-block font-display font-bold text-xl md:text-2xl tracking-[-0.01em] leading-tight self-start">
                <span>{a.title}</span>
                <span class="absolute left-0 right-0 -bottom-1 h-[2px] bg-primary" aria-hidden="true" />
              </div>
              <p class="hidden md:block font-body text-sm text-on-ink-2 leading-relaxed self-center">{a.text}</p>
              <p class="md:hidden col-start-2 font-body text-sm text-on-ink-2 leading-relaxed mt-3">{a.text}</p>
            </div>
          </li>
        ))
      }
    </ul>

    {
      fit.cta && (
        <div data-reveal class="mt-12 flex justify-center">
          <a href="#contact" class="btn-primary inline-flex">{fit.cta} ↗</a>
        </div>
      )
    }
  </div>
</section>
