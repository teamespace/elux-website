---
import { Image } from 'astro:assets'
import BaseLayout from '../layouts/BaseLayout.astro'
import Nav from './Nav.astro'
import Footer from './Footer.astro'
import cover from '../assets/work-images/travelcircus/cover.png'
import offerDetail from '../assets/work-images/travelcircus/mockup-1.png'
import bookingSuccess from '../assets/work-images/travelcircus/mockup-2.png'
import bookingManagement from '../assets/work-images/travelcircus/mockup-3.png'
import finalMockup from '../assets/work-images/travelcircus/final-mockup-1.png'
import finalMockup2 from '../assets/work-images/travelcircus/final-mockup-2.png'
import finalMockup3 from '../assets/work-images/travelcircus/final-mockup-3.png'
import prototypeVideo from '../assets/work-images/travelcircus/prototype.mp4?url'

type Variant = 'editorial' | 'scrollytelling' | 'dossier'

interface PrevNext {
  slug: string
  title: string
  category?: string
  tags?: string[]
  description?: string
  img?: any
  video?: any
}

interface Props {
  variant: Variant
  preview?: boolean
  data?: any
  moreWork?: PrevNext[]
}

const { variant, preview = true, data, moreWork = [] } = Astro.props

const isFilled = (v: unknown) => typeof v === 'string' && v.length > 0 && !v.startsWith('[')
const hasYear = isFilled(data?.year)
const hasTimeline = isFilled(data?.timeline)
const hasServices = Array.isArray(data?.services) && data.services.length > 0

const concepts = [
  { id: 'editorial', label: '01 Editorial chapters' },
  { id: 'scrollytelling', label: '02 Guided scrollytelling' },
  { id: 'dossier', label: '03 Product dossier' },
] as const

const activeConcept = concepts.find((concept) => concept.id === variant) ?? concepts[0]

const timeline = [
  { year: '2024', title: 'First collaborations', detail: 'Website, content, and design support' },
  { year: '2025', title: 'More projects, more context', detail: 'Repeat work across different needs' },
  { year: '2026', title: 'Into the mobile product', detail: 'Product design + interactive prototyping' },
]

const prototypeReasons = [
  { number: '01', title: 'Experience, not imagine', detail: 'The team reacted to a working journey, not isolated frames. Every tap, transition, and screen state could be felt the way a real user would encounter it, instead of being described in a meeting.' },
  { number: '02', title: 'Clearer feedback', detail: 'Problems surfaced in context, while the flow was still flexible enough to change. That meant fewer notes on static screens and more conversations about how the product actually behaved.' },
  { number: '03', title: 'Faster decisions', detail: 'Less guesswork between what was designed and how it actually felt, so the team could commit to a direction with confidence instead of waiting for a full build to validate it.' },
  { number: '04', title: 'One shared reference', detail: 'Design and stakeholders reviewed the exact same working flow, so conversations stayed focused on the product itself instead of everyone interpreting static screens differently.' },
]

const featureCards = [
  { title: 'Travel Discovery & Top Deals', image: cover, asset: 'Home Screen / Exploration Top Deals' },
  { title: 'Search & Travel Listings', image: finalMockup2, asset: 'Search Screen + PLP Screen' },
  { title: 'Package & Offer Details', image: offerDetail, asset: 'PDP Screen / Voucher PDP Screen' },
  { title: 'Hotel & Ticket Booking', image: finalMockup3, asset: 'Booking Ticket + Hotel Screen' },
  { title: 'Checkout & Booking Confirmation', image: bookingSuccess, asset: 'Checkout Screen' },
  { title: 'My Bookings & Trip Management', image: bookingManagement, asset: 'My Booking Screen' },
]

const pageTitle = preview
  ? `Travelcircus — ${activeConcept.label} | Elux Space`
  : 'Travelcircus — Mobile Travel Booking App Design | Elux Space'

const pageDescription = 'Travelcircus mobile travel booking app design by Elux Space, shaped through an ongoing partnership, mobile-first product thinking, and interactive prototyping.'

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: 'Travelcircus - Mobile Travel Booking App Design',
  about: pageDescription,
  creator: { '@type': 'Organization', name: 'Elux Space', url: 'https://elux.space/' },
}
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  noindex={preview}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  <div class={`concept-page concept-page--${variant} bg-cream text-ink min-h-screen`}>
    <Nav />

    <main id="main">
      {preview && (
        <nav class="concept-switcher" aria-label="Travelcircus concept previews">
          <div class="concept-shell concept-switcher__inner">
            <a class="concept-switcher__back" href="/work/travelcircus-concepts">← Concepts</a>
            <div class="concept-switcher__links">
              {concepts.map((concept) => (
                <a
                  href={`/work/travelcircus-concepts/${concept.id}`}
                  aria-current={concept.id === variant ? 'page' : undefined}
                >
                  {concept.label}
                </a>
              ))}
            </div>
          </div>
        </nav>
      )}

      <header class="concept-hero">
        <div class="concept-shell">
          <a href="/work" class="concept-back">← All work</a>
          {data?.tagline && (
            <span class="inline-block font-body font-semibold text-[11px] uppercase tracking-[0.1em] text-cream bg-primary px-3 py-1.5 rounded-chip mb-5">
              {data.tagline}
            </span>
          )}
          <h1 class="display-xl mb-8">{data?.client ?? 'Travelcircus'}</h1>
          {data?.summary && <p class="body-lg text-ink-2 max-w-2xl mb-10">{data.summary}</p>}
          <dl class="grid grid-cols-2 md:grid-cols-3 gap-6 border-t-2 border-ink pt-8">
            {hasYear && (
              <div>
                <dt class="eyebrow text-ink-3 mb-2">Year</dt>
                <dd class="font-display font-bold text-lg text-ink">{data.year}</dd>
              </div>
            )}
            {hasTimeline && (
              <div>
                <dt class="eyebrow text-ink-3 mb-2">Timeline</dt>
                <dd class="font-display font-bold text-lg text-ink">{data.timeline}</dd>
              </div>
            )}
            {hasServices && (
              <div>
                <dt class="eyebrow text-ink-3 mb-2">Services</dt>
                <dd class="font-body text-sm text-ink-2">{data.services.join(', ')}</dd>
              </div>
            )}
          </dl>
          <div class="concept-hero__visual">
            <Image src={cover} alt="Travelcircus mobile app home screen" />
          </div>
        </div>
      </header>

      {variant === 'editorial' && (
        <div class="editorial-story">
          <section class="chapter chapter--background">
            <div class="concept-shell">
              <div class="chapter-copy">
                <div>
                  <p class="concept-eyebrow">Project background</p>
                  <h2 class="display-lg">Six projects in, the work moved deeper into the product.</h2>
                </div>
                <div class="chapter-body">
                  <p>We’ve worked with Travelcircus since 2024 across more than six projects, from website and content support to ongoing design work.</p>
                  <p>Each project led naturally to the next. What kept the relationship growing was consistency across different needs, building more trust in how we work together and eventually bringing the collaboration deeper into the product with their mobile app.</p>
                </div>
              </div>

              <div class="relationship-board">
                <blockquote>
                  <span class="quote-mark" aria-hidden="true">“</span>
                  <p>Elux designed our app from the ground up — and delivered something that genuinely reflects our brand: clean, intuitive, and built with the end user in mind. Every design decision felt intentional.</p>
                  <footer><strong>Gunnar Asmussen, Travelcircus</strong><span>May 22, 2026</span></footer>
                </blockquote>
                <div class="timeline-panel">
                  <ol>
                    {timeline.map((item) => (
                      <li>
                        <span class="timeline-year">{item.year}</span>
                        <span class="timeline-dot" aria-hidden="true"></span>
                        <span><strong>{item.title}</strong><small>{item.detail}</small></span>
                      </li>
                    ))}
                  </ol>
                  <div class="timeline-panel__scene" data-mini-px-scene aria-hidden="true">
                    <div class="mini-px-walker">
                      <div class="pixel-sprite pixel-sprite--poke" style="--w:18; --h:25; --idle:0.55s; --px:2; background-image:url('/sprites/astronaut-dark.png')" />
                    </div>
                    <div class="mini-px-flyer">
                      <div class="pixel-sprite pixel-sprite--poke" style="--w:22; --h:14; --idle:0.45s; --px:2; background-image:url('/sprites/ufo-dark.png')" />
                    </div>
                  </div>
                  <div class="relationship-stat"><strong>6+</strong><span>projects<br />together we collaborate since 2024</span></div>
                </div>
              </div>
            </div>
          </section>

          <section class="chapter chapter--shift">
            <div class="concept-shell">
              <div class="chapter-copy">
                <div>
                  <p class="concept-eyebrow">Product shift</p>
                  <h2 class="display-lg">Same product depth. The experience had to change.</h2>
                </div>
                <div class="chapter-body">
                  <p>Travelcircus already brought together a complex multi-layer set of journeys across discovery, package details, pricing, booking, ticketing, and trip management.</p>
                  <p>Bringing that depth to mobile wasn’t about shrinking the interface. The same features had to work around different priorities, behaviors, and moments of attention, so we rethought how information was surfaced and how users moved from one decision to the next.</p>
                </div>
              </div>
              <div
                class="compare-slider"
                data-compare-slider
                role="slider"
                aria-label="Drag to compare the existing web experience against the final mobile screen"
                aria-valuemin="0"
                aria-valuemax="100"
                aria-valuenow="50"
                tabindex="0"
              >
                <div class="compare-slider__layer compare-slider__layer--after">
                  <Image src={finalMockup} alt="Travelcircus final mobile screen" />
                  <span class="compare-slider__tag compare-slider__tag--after">After</span>
                </div>
                <div class="compare-slider__layer compare-slider__layer--before" data-compare-before>
                  <div class="asset-placeholder asset-placeholder--web"><span>Asset placeholder</span><strong>Existing web experience<br />or early user flow map</strong></div>
                  <span class="compare-slider__tag compare-slider__tag--before">Before</span>
                </div>
                <div class="compare-slider__handle" data-compare-handle>
                  <span class="compare-slider__grip" aria-hidden="true">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M8 7L3 12L8 17M16 7L21 12L16 17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  </span>
                </div>
              </div>
            </div>
          </section>

          <section class="chapter chapter--prototype bg-ink-bg text-on-ink">
            <div class="concept-shell">
              <div class="chapter-copy">
                <div>
                  <p class="concept-eyebrow">Faster decisions</p>
                  <h2 class="display-lg">We started using the app before the screens were finished.</h2>
                </div>
                <div class="chapter-body">
                  <p>Interactive prototypes connected the key journeys early, so the team could experience discovery, booking, and ticketing as one product instead of imagining how separate Figma screens would eventually work together.</p>
                  <p>That made feedback clearer, reduced guesswork, and helped us iterate and make decisions faster, bringing the core mobile flow together within one month.</p>
                </div>
              </div>
              <div class="prototype-sticky">
                <div class="prototype-sticky__media">
                  <div class="prototype-media-frame" data-video-toggle-wrap>
                    <video class="prototype-media" autoplay loop muted playsinline preload="auto" poster={cover.src} aria-label="Travelcircus interactive prototype" data-prototype-video>
                      <source src={prototypeVideo} type="video/mp4" />
                      Your browser does not support embedded videos.
                    </video>
                    <button type="button" class="prototype-media-toggle" data-video-toggle aria-label="Pause video">
                      <svg class="icon-pause" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="4" width="4" height="16" rx="1" /><rect x="14" y="4" width="4" height="16" rx="1" /></svg>
                      <svg class="icon-play" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M7 4.5v15l13-7.5-13-7.5Z" /></svg>
                    </button>
                  </div>
                </div>
                <div class="prototype-sticky__list">
                  <h3>Why prototype early?</h3>
                  {prototypeReasons.map((reason) => (
                    <article class="prototype-reason" data-prototype-reason>
                      <strong>{reason.title}</strong>
                      <p>{reason.detail}</p>
                    </article>
                  ))}
                </div>
              </div>
            </div>
          </section>

          <section class="chapter chapter--features">
            <div class="concept-shell">
              <p class="concept-eyebrow">Final product</p>
              <div class="feature-grid">
                {featureCards.map((feature, index) => (
                  <article class:list={['feature-card', `feature-card--${index + 1}`]}>
                    {feature.image ? (
                      <Image src={feature.image} alt={`Travelcircus ${feature.title}`} />
                    ) : (
                      <div class="asset-placeholder"><span>Asset placeholder</span><strong>{feature.asset}</strong></div>
                    )}
                    <div class="feature-card__caption">
                      <span class="feature-card__badge">0{index + 1} · {feature.title}</span>
                    </div>
                  </article>
                ))}
              </div>
            </div>
          </section>
        </div>
      )}

      {variant === 'scrollytelling' && (
        <div class="scrolly-story">
          <section class="scrolly-chapter">
            <div class="scrolly-copy">
              <p class="concept-eyebrow">01 · Project background</p>
              <h2 class="display-lg">Six projects in, the work moved deeper into the product.</h2>
              <p>We’ve worked with Travelcircus since 2024 across more than six projects, from website and content support to ongoing design work.</p>
              <p>Each project led naturally to the next. What kept the relationship growing was consistency across different needs, building more trust in how we work together and eventually bringing the collaboration deeper into the product with their mobile app.</p>
            </div>
            <div class="scrolly-visual scrolly-visual--relationship">
              <blockquote>
                <span class="quote-mark" aria-hidden="true">“</span>
                <p>Elux designed our app from the ground up — and delivered something that genuinely reflects our brand: clean, intuitive, and built with the end user in mind. Every design decision felt intentional.</p>
                <footer><strong>Gunnar Asmussen, Travelcircus</strong><span>May 22, 2026</span></footer>
              </blockquote>
              <ol class="scrolly-timeline">
                {timeline.map((item) => <li><b>{item.year}</b><span><strong>{item.title}</strong><small>{item.detail}</small></span></li>)}
              </ol>
              <div class="relationship-stat"><strong>6+</strong><span>projects<br />together we collaborate since 2024</span></div>
            </div>
          </section>

          <section class="scrolly-chapter scrolly-chapter--dark">
            <div class="scrolly-copy">
              <p class="concept-eyebrow">02 · Product shift</p>
              <h2 class="display-lg">Same product depth. The experience had to change.</h2>
              <p>Travelcircus already brought together a complex multi-layer set of journeys across discovery, package details, pricing, booking, ticketing, and trip management.</p>
              <p>Bringing that depth to mobile wasn’t about shrinking the interface. The same features had to work around different priorities, behaviors, and moments of attention, so we rethought how information was surfaced and how users moved from one decision to the next.</p>
            </div>
            <div class="scrolly-visual scrolly-visual--comparison">
              <div class="asset-placeholder on-ink"><span>Asset placeholder</span><strong>Existing web experience<br />or early user flow map</strong></div>
              <span class="scrolly-arrow" aria-hidden="true">↓</span>
              <figure><Image src={offerDetail} alt="Travelcircus final mobile offer detail screen" /><figcaption>Final mobile screen</figcaption></figure>
            </div>
          </section>

          <section class="scrolly-chapter">
            <div class="scrolly-copy">
              <p class="concept-eyebrow">03 · Faster decisions</p>
              <h2 class="display-lg">We started using the app before the screens were finished.</h2>
              <p>Interactive prototypes connected the key journeys early, so the team could experience discovery, booking, and ticketing as one product instead of imagining how separate Figma screens would eventually work together.</p>
              <p>That made feedback clearer, reduced guesswork, and helped us iterate and make decisions faster, bringing the core mobile flow together within one month.</p>
            </div>
            <div class="scrolly-visual scrolly-visual--prototype">
              <video class="prototype-media" controls muted playsinline preload="metadata" poster={cover.src} aria-label="Travelcircus interactive prototype">
                <source src={prototypeVideo} type="video/mp4" />
                Your browser does not support embedded videos.
              </video>
              <div class="scrolly-reasons">
                <h3>Why prototype early?</h3>
                {prototypeReasons.map((reason) => <article><span>{reason.number}</span><div><strong>{reason.title}</strong><p>{reason.detail}</p></div></article>)}
              </div>
            </div>
          </section>

          <section class="scrolly-chapter scrolly-chapter--features">
            <div class="scrolly-copy">
              <p class="concept-eyebrow">04 · Final product</p>
            </div>
            <div class="scrolly-visual scrolly-feature-stack">
              {featureCards.map((feature, index) => (
                <article>
                  {feature.image ? <Image src={feature.image} alt={`Travelcircus ${feature.title}`} /> : <div class="asset-placeholder"><span>Asset placeholder</span><strong>{feature.asset}</strong></div>}
                  <div><span>0{index + 1}</span><h3>{feature.title}</h3></div>
                </article>
              ))}
            </div>
          </section>
        </div>
      )}

      {variant === 'dossier' && (
        <div class="dossier-story">
          <section class="dossier-grid concept-shell">
            <article class="dossier-card dossier-card--intro">
              <p class="concept-eyebrow">Project background</p>
              <h2 class="display-lg">Six projects in, the work moved deeper into the product.</h2>
              <div class="dossier-card__columns">
                <p>We’ve worked with Travelcircus since 2024 across more than six projects, from website and content support to ongoing design work.</p>
                <p>Each project led naturally to the next. What kept the relationship growing was consistency across different needs, building more trust in how we work together and eventually bringing the collaboration deeper into the product with their mobile app.</p>
              </div>
            </article>

            <article class="dossier-card dossier-card--stat"><strong>6+</strong><span>projects<br />together we collaborate since 2024</span></article>

            <blockquote class="dossier-card dossier-card--quote">
              <span class="quote-mark" aria-hidden="true">“</span>
              <p>Elux designed our app from the ground up — and delivered something that genuinely reflects our brand: clean, intuitive, and built with the end user in mind. Every design decision felt intentional.</p>
              <footer><strong>Gunnar Asmussen, Travelcircus</strong><span>May 22, 2026</span></footer>
            </blockquote>

            <article class="dossier-card dossier-card--timeline">
              <p class="concept-eyebrow">Collaboration journey</p>
              <ol>{timeline.map((item) => <li><b>{item.year}</b><span><strong>{item.title}</strong><small>{item.detail}</small></span></li>)}</ol>
            </article>

            <article class="dossier-card dossier-card--shift-copy">
              <p class="concept-eyebrow">Product shift</p>
              <h2 class="display-md">Same product depth. The experience had to change.</h2>
              <p>Travelcircus already brought together a complex multi-layer set of journeys across discovery, package details, pricing, booking, ticketing, and trip management.</p>
              <p>Bringing that depth to mobile wasn’t about shrinking the interface. The same features had to work around different priorities, behaviors, and moments of attention, so we rethought how information was surfaced and how users moved from one decision to the next.</p>
            </article>

            <article class="dossier-card dossier-card--before"><div class="asset-placeholder"><span>Asset placeholder</span><strong>Existing web experience<br />or early user flow map</strong></div></article>
            <figure class="dossier-card dossier-card--after"><Image src={offerDetail} alt="Travelcircus final mobile offer detail screen" /><figcaption>Final mobile screen</figcaption></figure>

            <article class="dossier-card dossier-card--prototype-copy">
              <p class="concept-eyebrow">Faster decisions</p>
              <h2 class="display-md">We started using the app before the screens were finished.</h2>
              <p>Interactive prototypes connected the key journeys early, so the team could experience discovery, booking, and ticketing as one product instead of imagining how separate Figma screens would eventually work together.</p>
              <p>That made feedback clearer, reduced guesswork, and helped us iterate and make decisions faster, bringing the core mobile flow together within one month.</p>
            </article>

            <article class="dossier-card dossier-card--video">
              <video class="prototype-media" controls muted playsinline preload="metadata" poster={cover.src} aria-label="Travelcircus interactive prototype">
                <source src={prototypeVideo} type="video/mp4" />
                Your browser does not support embedded videos.
              </video>
            </article>

            <article class="dossier-card dossier-card--reasons">
              <h3>Why prototype early?</h3>
              <ol>{prototypeReasons.map((reason) => <li><span>{reason.number}</span><div><strong>{reason.title}</strong><p>{reason.detail}</p></div></li>)}</ol>
            </article>

            <article class="dossier-card dossier-card--feature-heading"><p class="concept-eyebrow">Final product</p></article>
            {featureCards.map((feature, index) => (
              <article class="dossier-card dossier-card--feature">
                {feature.image ? <Image src={feature.image} alt={`Travelcircus ${feature.title}`} /> : <div class="asset-placeholder"><span>Asset placeholder</span><strong>{feature.asset}</strong></div>}
                <div><span>0{index + 1}</span><h3>{feature.title}</h3></div>
              </article>
            ))}
          </section>
        </div>
      )}

      {!preview && moreWork.length > 0 && (
        <section class="case-more bg-cream border-t-2 border-ink">
          <div class="mx-auto max-w-page px-6 lg:px-10 py-16 md:py-24">
            <div class="eyebrow text-ink-3 mb-3">MORE WORK</div>
            <h2 class="display-lg text-ink mb-10 md:mb-14">Explore other case studies.</h2>
            <div class="grid md:grid-cols-2 gap-x-6 gap-y-12">
              {moreWork.map((c, i) => (
                <a href={`/work/${c.slug}`} class="group block">
                  <div class="relative w-full aspect-[16/10] rounded-media overflow-hidden">
                    {c.video ? (
                      <video
                        src={c.video}
                        class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                        autoplay
                        muted
                        loop
                        playsinline
                        preload="metadata"
                        aria-hidden="true"
                      />
                    ) : c.img ? (
                      <div
                        class="absolute inset-0 bg-cover bg-center transition-transform duration-500 group-hover:scale-[1.03]"
                        style={`background-image: url(${c.img.src});`}
                        aria-hidden="true"
                      />
                    ) : (
                      <div class="img-placeholder absolute inset-0 rounded-media">
                        IMAGE: {c.title}
                      </div>
                    )}
                    <div class="absolute inset-0 rounded-media ring-1 ring-inset ring-ink/10" />
                  </div>

                  <div class="pt-5">
                    <div class="flex items-center gap-3 mb-3">
                      <span class="font-body font-semibold text-[11px] tracking-[0.14em] text-ink-3 tabular-nums">
                        {String(i + 1).padStart(2, '0')}
                      </span>
                      {c.category && (
                        <span class="font-body font-semibold text-[10px] uppercase tracking-[0.12em] text-primary">
                          {c.category}
                        </span>
                      )}
                    </div>

                    <h3 class="font-display font-bold text-[19px] md:text-[22px] tracking-[-0.01em] text-ink mb-3 group-hover:text-primary transition-colors">
                      {c.title}
                    </h3>

                    {c.tags && c.tags.length > 0 && (
                      <ul class="flex flex-wrap gap-2 mb-3">
                        {c.tags.map((t) => (
                          <li class="font-body font-semibold text-[10px] uppercase tracking-[0.1em] text-ink-2 border border-ink/20 px-2.5 py-1 rounded-chip">
                            {t}
                          </li>
                        ))}
                      </ul>
                    )}

                    {c.description && (
                      <p class="font-body text-[14px] text-ink-2 leading-relaxed max-w-prose">{c.description}</p>
                    )}
                  </div>
                </a>
              ))}
            </div>
          </div>
        </section>
      )}

      <section class="concept-closing">
        <div class="concept-shell concept-closing__grid">
          <div>
            <p class="concept-eyebrow">We’re still moving!</p>
            <h2 class="display-lg">Some projects end at handoff. This one became another chapter.</h2>
          </div>
          <div class="concept-closing__body">
            <p>The mobile app became another step in an ongoing partnership that keeps evolving with what Travelcircus needs next.</p>
            <p>If your product needs a team that can step in, adapt quickly, and keep moving with you, <strong>let’s talk!</strong></p>
            <div class="concept-closing__actions"><a class="btn-primary" href="/#contact">Start a project ↗</a><a class="btn-cream" href="/work">See more work</a></div>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </div>
</BaseLayout>

<style is:global>
  .concept-page { --concept-max: 1240px; overflow: clip; }
  .concept-shell { width: min(calc(100% - 48px), var(--concept-max)); margin-inline: auto; }
