  function initCompareSliders() {
    document.querySelectorAll<HTMLElement>('[data-compare-slider]').forEach((root) => {
      const before = root.querySelector<HTMLElement>('[data-compare-before]')
      const handle = root.querySelector<HTMLElement>('[data-compare-handle]')
      if (!before || !handle) return

      const setPercent = (percent: number) => {
        const clamped = Math.min(100, Math.max(0, percent))
        before.style.clipPath = `inset(0 ${100 - clamped}% 0 0)`
        handle.style.left = `${clamped}%`
        root.setAttribute('aria-valuenow', String(Math.round(clamped)))
      }

      const percentFromClientX = (clientX: number) => {
        const rect = root.getBoundingClientRect()
        return ((clientX - rect.left) / rect.width) * 100
      }

      const onPointerMove = (event: PointerEvent) => setPercent(percentFromClientX(event.clientX))

      const stopDragging = () => {
        window.removeEventListener('pointermove', onPointerMove)
        window.removeEventListener('pointerup', stopDragging)
      }

      const startDragging = (clientX: number) => {
        setPercent(percentFromClientX(clientX))
        window.addEventListener('pointermove', onPointerMove)
        window.addEventListener('pointerup', stopDragging)
      }

      root.addEventListener('pointerdown', (event) => {
        event.preventDefault()
        startDragging(event.clientX)
      })

      root.addEventListener('keydown', (event) => {
        const current = parseFloat(root.getAttribute('aria-valuenow') || '50')
        if (event.key === 'ArrowLeft') setPercent(current - 5)
        if (event.key === 'ArrowRight') setPercent(current + 5)
      })

      setPercent(50)
    })
  }

  function initPrototypeVideos() {
    document.querySelectorAll<HTMLElement>('[data-video-toggle-wrap]').forEach((wrap) => {
      const video = wrap.querySelector<HTMLVideoElement>('[data-prototype-video]')
      const toggle = wrap.querySelector<HTMLButtonElement>('[data-video-toggle]')
      if (!video || !toggle) return

      video.playbackRate = 1.5

      toggle.addEventListener('click', () => {
        if (video.paused) {
          video.play()
          toggle.classList.remove('is-paused')
          toggle.setAttribute('aria-label', 'Pause video')
        } else {
          video.pause()
          toggle.classList.add('is-paused')
          toggle.setAttribute('aria-label', 'Play video')
        }
      })
    })
  }

  function initPrototypeReasons() {
    const items = document.querySelectorAll<HTMLElement>('[data-prototype-reason]')
    if (!items.length) return

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => entry.target.classList.toggle('is-active', entry.isIntersecting))
      },
      { rootMargin: '-45% 0px -45% 0px', threshold: 0 }
    )

    items[0].classList.add('is-active')
    items.forEach((item) => observer.observe(item))
  }

  function initMiniPixelScenes() {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return

    document.querySelectorAll<HTMLElement>('[data-mini-px-scene]').forEach((scene) => {
      scene.addEventListener('click', (e) => {
        const el = (e.target as HTMLElement).closest<HTMLElement>('.pixel-sprite')
        if (!el || el.classList.contains('is-reacting')) return

        const isWalker = el.closest('.mini-px-walker') !== null
        el.classList.add('is-reacting')
        if (isWalker) scene.classList.add('is-astro-reacting')

        setTimeout(() => {
          el.classList.remove('is-reacting')
          if (isWalker) scene.classList.remove('is-astro-reacting')
        }, 600)
      })
    })
  }

  initCompareSliders()
  initPrototypeVideos()
  initPrototypeReasons()
  initMiniPixelScenes()
</script>
